{
	"name": "PL_NETFLIX_COPY_INCREMENTAL",
	"properties": {
		"activities": [
			{
				"name": "GM_ListFiles",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_SRC_FOLDER_BIN",
						"type": "DatasetReference",
						"parameters": {
							"pFolder": "@{pipeline().parameters.pSourceFolder}"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "FE_CheckEachFile",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GM_ListFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_ListFiles').output.childItems",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 20,
					"activities": [
						{
							"name": "GM_FileProps",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_ADLS_SRC_FILE_BIN",
									"type": "DatasetReference",
									"parameters": {
										"pFolder": "@{pipeline().parameters.pSourceFolder}",
										"pFile": "@{item().name}"
									}
								},
								"fieldList": [
									"lastModified",
									"size"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "BinaryReadSettings"
								}
							}
						},
						{
							"name": "IF_ChangedAfterWatermark",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "GM_FileProps",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('GM_FileProps').output.lastModified, pipeline().parameters.pLastWatermarkUtc)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Copy_ChangedFile_To_Landing",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "BinarySource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true
												},
												"formatSettings": {
													"type": "BinaryReadSettings"
												}
											},
											"sink": {
												"type": "BinarySink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_ADLS_SRC_FILE_BIN",
												"type": "DatasetReference",
												"parameters": {
													"pFolder": "@{pipeline().parameters.pSourceFolder}",
													"pFile": "@{item().name}"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_LANDING_FILE_BIN",
												"type": "DatasetReference",
												"parameters": {
													"pFolder": "@{concat(pipeline().parameters.pLandingBaseFolder,'/',pipeline().parameters.pIngestDateFolder)}",
													"pFile": "@{item().name}"
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pSourceFolder": {
				"type": "String"
			},
			"pLandingBaseFolder": {
				"type": "String"
			},
			"pIngestDateFolder": {
				"type": "String"
			},
			"pLastWatermarkUtc": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-02-22T11:38:52Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}