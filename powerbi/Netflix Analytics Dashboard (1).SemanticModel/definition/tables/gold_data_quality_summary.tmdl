table gold_data_quality_summary
	lineageTag: c3378fec-2161-4d26-a2cc-1b0ed287437d

	measure 'Total Rows' =
			
			SUM(gold_data_quality_summary[row_count])
		formatString: 0
		lineageTag: fe17656e-a45b-4808-9509-3f0b341ec148

	measure 'Valid Rows' =
			
			CALCULATE(
			    [Total Rows],
			    gold_data_quality_summary[data_quality_status] = "VALID"
			)
		formatString: 0
		lineageTag: 1d05ce72-9b4f-4c1a-9fcb-45118abcfb3a

	measure 'Invalid Rows' =
			
			[Total Rows] - [Valid Rows]
		formatString: 0
		lineageTag: 0544797a-7978-41d1-8934-2243b27d75fa

	measure 'Data Quality %' =
			
			DIVIDE(
			    [Valid Rows],
			    [Total Rows],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a620e443-43be-442a-9964-2fb28fb9e080

	column source_area
		dataType: string
		lineageTag: 3c92b612-0990-4c9f-abcf-6c02b5063cb9
		summarizeBy: none
		sourceColumn: source_area

		annotation SummarizationSetBy = Automatic

	column data_quality_status
		dataType: string
		lineageTag: 3b081896-053b-4e5b-995e-47f960307878
		summarizeBy: none
		sourceColumn: data_quality_status

		annotation SummarizationSetBy = Automatic

	column row_count
		dataType: int64
		formatString: 0
		lineageTag: 4a18087c-42f5-43d3-9611-7789b9bf06f7
		summarizeBy: sum
		sourceColumn: row_count

		annotation SummarizationSetBy = Automatic

