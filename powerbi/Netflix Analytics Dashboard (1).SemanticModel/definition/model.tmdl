model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["gold_content_performance","gold_data_quality_summary"]

annotation PBI_ProTooling = ["WebModelingEdit"]

ref table gold_content_performance
ref table gold_data_quality_summary

ref cultureInfo en-US

